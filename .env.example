# Kopiera till .env.local. Allt är valfritt lokalt: utan värde stängs funktionen av
# eller ersätts av en mock. Lägg till varje ny variabel här i samma ändring som koden.

# --- Databas -----------------------------------------------------------------
# Postgres. Tomt = sajten kör utan sparade ordrar, butiker och utskick.
DATABASE_URL=
# "require" slår på SSL mot databasen (drift).
DATABASE_SSL=

# --- Inlogg ------------------------------------------------------------------
# Admin-inloggets lösenord på /admin (namnskylt.com). Signerar också inloggningskakorna.
# Återförsäljare loggar in på /aterforsaljare med e-post och eget lösenord.
RESELLER_PASSWORD=
# Lösenord som låser hela sajten före lansering. Tomt = sajten är öppen.
SITE_GATE_PASSWORD=
# Verkstadens lösenord till /verkstad. Tomt = sidan finns inte.
PRODUCTION_PASSWORD=

# --- Värdnamn ----------------------------------------------------------------
# Kommaseparerade värdar som är huvudsajten; andra värdar tolkas som butiker.
# Standard: namnskylt.com,www.namnskylt.com,localhost
SITE_HOSTS=
# Porten middleware anropar sig själv på. Standard: 3100
INTERNAL_PORT=

# --- Leverantörs-API (Skylt & Gravyrteknik) ----------------------------------
# Strömbrytaren för ordrar till verkstaden. Tomt = ordrar sparas och väntar under
# /admin/tillverkning, och ingenting skickas. Med båda satta skickas varje ny order
# direkt (POST <URL>/orders med Bearer-nyckeln), och väntande ordrar går att skicka
# en i taget från adminens översikt.
# Basadressen får ha en egen sökväg: https://www.skyltochgravyr.com/api/partner
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
# Delad nyckel för leverantörens statuswebhook (POST /api/supplier/webhook). Tomt = webhooken stängd.
SUPPLIER_WEBHOOK_SECRET=

# --- Sajtens egna mejl ---------------------------------------------------------
# Strömbrytaren för alla mejl sajten skickar själv: besked till panelens ägare (kunden har
# svarat på en offert eller ett korrektur, lagt en order, verkstaden har skickat, eller ett
# företag har ansökt), kundens orderbekräftelse, mejlet om att ordern är skickad och länken
# för den som har glömt sitt lösenord. Beskeden syns alltid i panelen. Mejlen skickas först
# när RESEND_API_KEY är satt OCH avsändaren står här, t.ex. namnskylt.com <besked@mail.namnskylt.com>.
# Tomt = inga mejl. OUTREACH_DISABLED=true stänger också av dem.
NOTICE_FROM_EMAIL=
# Sajtens publika adress, som länkar i mejlen och kortbetalningens returadresser byggs på.
# Standard: https://www.namnskylt.com
NOTICE_PUBLIC_URL=

# --- Kortbetalning (Stripe) ----------------------------------------------------
# Privatpersoner betalar med kort i kassan på namnskylt.com; företag faktureras som förut.
# Båda nycklarna krävs. Tomt = kortbetalningen är av, och bara företag kan beställa.
# Webhooken läggs upp hos Stripe mot /api/payments/webhook för händelserna
# checkout.session.completed och checkout.session.async_payment_succeeded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI och rendering --------------------------------------------------------
# OpenAI — bilder där personer bär skylten. Tomt = funktionen avstängd.
OPENAI_API_KEY=
# Sökväg till Chromium för PDF och inläsning av hemsidor. Tomt = installerad Chrome används.
CHROMIUM_PATH=

# --- Utskick till återförsäljare ---------------------------------------------
# Resend. Tomt = inga mejl lämnar systemet; de skrivs till OUTREACH_OUTBOX_DIR.
RESEND_API_KEY=
# Svix-nyckel för Resends webhook (POST /api/outreach/webhook). Tomt = webhooken stängd.
RESEND_WEBHOOK_SECRET=
# "true" tvingar provläge oavsett övriga inställningar (nödstopp).
OUTREACH_DISABLED=
# Domänen avsändaradressen måste ligga på, t.ex. mail.namnskylt.com.
OUTREACH_SENDING_DOMAIN=
# Kommaseparerade adresser. När listan är satt får bara de skarpa mejl; uppvärmningens vecka 0 kräver den.
OUTREACH_ALLOWLIST=
# Hemlighet (minst 32 tecken) som signerar landnings- och avregistreringslänkar.
OUTREACH_LINK_SECRET=
# Föregående hemlighet; godkänns fortfarande efter ett byte men används inte för nya länkar.
OUTREACH_LINK_SECRET_PREVIOUS=
# Bearer-hemlighet (minst 32 tecken) för cron-anropet POST /api/outreach/tick. Tomt = stängd.
OUTREACH_TICK_SECRET=
# Adressen länkarna i mejlen pekar på. Standard: https://namnskylt.com
OUTREACH_PUBLIC_URL=
# Mapp för mejl i provläge. Standard: tmp/outreach-outbox
OUTREACH_OUTBOX_DIR=
# Sökväg till kundlistan (xlsx) för `pnpm outreach:import`. Filen ligger utanför repot.
OUTREACH_LEADS_FILE=
# Bokningslänk på landningssidan. Visas bara om den börjar med https://
CALENDLY_URL=
