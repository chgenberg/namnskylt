{
  "name": "namnskylt",
  "version": "0.1.0",
  "private": true,
  "description": "Namnskyltar och pins — graverade namnskyltar med egen skyltmotor. Tillverkning via Skylt & Gravyrteknik.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/engine/*.test.ts src/lib/**/*.test.ts",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\""
  },
  "dependencies": {
    "@react-three/drei": "10",
    "@react-three/fiber": "9",
    "@resvg/resvg-js": "^2.6.2",
    "geist": "^1.8.2",
    "motion": "^14.6.0",
    "next": "15",
    "openai": "^7.45.0",
    "opentype.js": "^2.0.0",
    "playwright-core": "^1.63.0",
    "react": "19",
    "react-dom": "19",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-gpu-pathtracer": "^0.0.27",
    "three-mesh-bvh": "^0.9.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "8",
    "eslint-config-next": "15",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
